# Postgres connection string used by Prisma.
# Local:  postgresql://postgres:postgres@localhost:5432/monopoly?schema=public
# Hosted: copy the pooled connection string from your provider.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monopoly?schema=public"

# HTTP server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (the React app).
CORS_ORIGIN="http://localhost:5173"
